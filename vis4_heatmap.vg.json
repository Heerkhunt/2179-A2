{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 620,
  "height": 300,
  "title": {
    "text": "Coffee Frequency by Age Group",
    "subtitle": "Darker cells show stronger weekly coffee habits.",
    "anchor": "start"
  },
  "data": {
    "url": "../data/coffee_frequency_age.csv"
  },
  "mark": {
    "type": "rect",
    "stroke": "#fff"
  },
  "encoding": {
    "x": {
      "field": "frequency",
      "type": "nominal",
      "title": null
    },
    "y": {
      "field": "age_group",
      "type": "nominal",
      "title": null
    },
    "color": {
      "field": "percentage",
      "type": "quantitative",
      "title": "Share (%)",
      "scale": {
        "scheme": "oranges"
      }
    },
    "tooltip": [
      {
        "field": "age_group"
      },
      {
        "field": "frequency"
      },
      {
        "field": "percentage",
        "title": "Share (%)"
      }
    ]
  },
  "config": {
    "background": "#FFF9F2",
    "view": {
      "stroke": null
    },
    "font": "Inter, Arial",
    "axis": {
      "labelColor": "#5C4737",
      "titleColor": "#3B2415",
      "gridColor": "#ead9c7"
    },
    "legend": {
      "labelColor": "#5C4737",
      "titleColor": "#3B2415"
    }
  }
}