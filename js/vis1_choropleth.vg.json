{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 620,
  "height": 420,
  "title": {
    "text": "Caf\u00e9s per 100,000 People by State",
    "subtitle": [
      "A population-normalised view avoids simply rewarding large states.",
      "ACT and Tasmania rank highest on caf\u00e9 availability."
    ],
    "anchor": "start"
  },
  "data": {
    "url": "data/australia_states_simplified.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "data/state_cafe_density.csv"
        },
        "key": "state_full",
        "fields": [
          "state",
          "cafe_count",
          "population",
          "cafes_per_100k"
        ]
      }
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "mark": {
    "type": "geoshape",
    "stroke": "#fff",
    "strokeWidth": 1.4
  },
  "encoding": {
    "color": {
      "field": "cafes_per_100k",
      "type": "quantitative",
      "title": "Caf\u00e9s per 100k",
      "scale": {
        "scheme": "yelloworangered",
        "domain": [
          26,
          44
        ]
      },
      "legend": {
        "orient": "right",
        "gradientLength": 240,
        "gradientThickness": 18
      }
    },
    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "title": "State"
      },
      {
        "field": "cafe_count",
        "type": "quantitative",
        "title": "Caf\u00e9s",
        "format": ","
      },
      {
        "field": "population",
        "type": "quantitative",
        "format": ","
      },
      {
        "field": "cafes_per_100k",
        "type": "quantitative",
        "title": "Caf\u00e9s per 100k",
        "format": ".2f"
      }
    ]
  },
  "config": {
    "background": "#FFF9F2",
    "view": {
      "stroke": null
    },
    "font": "Inter, Arial",
    "axis": {
      "labelColor": "#5C4737",
      "titleColor": "#3B2415",
      "gridColor": "#ead9c7"
    },
    "legend": {
      "labelColor": "#5C4737",
      "titleColor": "#3B2415"
    }
  }
}
