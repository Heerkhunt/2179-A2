{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 430,
  "height": 260,
  "title": {
    "text": "Cafés per 100k People by State",
    "subtitle": "Lollipop ranking highlights café access after population normalisation.",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "data": {
  "url": "data/state_cafe_density.csv"
}
  "transform": [
    {
      "calculate": "datum.cafes_per_100k",
      "as": "Cafe density"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#D8B48A",
        "strokeWidth": 3
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": "-x",
          "title": null
        },
        "x": {
          "value": 0
        },
        "x2": {
          "field": "Cafe density"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 180,
        "color": "#A85C2A",
        "stroke": "#3B2418",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": "-x",
          "title": null
        },
        "x": {
          "field": "Cafe density",
          "type": "quantitative",
          "title": "Cafés per 100k people",
          "scale": {
            "domain": [0, 50]
          }
        },
        "tooltip": [
          {
            "field": "state_full",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "cafe_count",
            "type": "quantitative",
            "title": "Café count",
            "format": ","
          },
          {
            "field": "population",
            "type": "quantitative",
            "title": "Population",
            "format": ","
          },
          {
            "field": "Cafe density",
            "type": "quantitative",
            "title": "Cafés per 100k",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#3B2418"
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "Cafe density",
          "type": "quantitative"
        },
        "text": {
          "field": "Cafe density",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],
  "config": {
    "background": "#FFFDF8",
    "view": {
      "stroke": null
    },
    "axis": {
      "grid": false,
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}
