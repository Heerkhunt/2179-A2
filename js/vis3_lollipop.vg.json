{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "autosize": {"type": "fit", "contains": "padding"},
  "width": 430,
  "height": 300,
  "title": {
    "text": "Which States Have the Strongest Café Access?",
    "subtitle": "Cafés per 100,000 people, ranked by state.",
    "anchor": "start",
    "font": "Inter, Arial",
    "fontSize": 15,
    "subtitleFont": "Inter, Arial",
    "subtitleFontSize": 12
  },
  "data": {
    "url": "data/state_cafe_density.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#D8B48A",
        "strokeWidth": 3
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "cafes_per_100k",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "labelFont": "Inter, Arial",
            "labelFontSize": 12
          }
        },
        "x": {
          "value": 0
        },
        "x2": {
          "field": "cafes_per_100k",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 190,
        "color": "#A85C2A",
        "stroke": "#3B2418",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "cafes_per_100k",
            "order": "descending"
          },
          "title": null
        },
        "x": {
          "field": "cafes_per_100k",
          "type": "quantitative",
          "title": "Cafés per 100k people",
          "scale": {
            "domain": [0, 50]
          },
          "axis": {
            "labelFont": "Inter, Arial",
            "titleFont": "Inter, Arial",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "grid": true
          }
        },
        "tooltip": [
          {"field": "state_full", "type": "nominal", "title": "State"},
          {"field": "cafe_count", "type": "quantitative", "title": "Cafés", "format": ","},
          {"field": "population", "type": "quantitative", "title": "Population", "format": ","},
          {"field": "cafes_per_100k", "type": "quantitative", "title": "Cafés per 100k", "format": ".2f"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "font": "Inter, Arial",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#3B2418"
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "cafes_per_100k",
            "order": "descending"
          }
        },
        "x": {
          "field": "cafes_per_100k",
          "type": "quantitative"
        },
        "text": {
          "field": "cafes_per_100k",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],
  "config": {
    "background": "#FFFDF8",
    "view": {"stroke": null},
    "font": "Inter, Arial",
    "axis": {
      "gridColor": "#ead9c7",
      "labelColor": "#5C4737",
      "titleColor": "#3B2415"
    }
  }
}
